# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
NEXT_PUBLIC_SITE_NAME=Crazilo
NEXT_PUBLIC_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
ADMIN_EMAIL=

# PayU - server-side only, never prefix with NEXT_PUBLIC_
# PAYU_MODE=test uses PAYU_TEST_* + test.payu.in; production uses PAYU_MERCHANT_* + secure.payu.in
PAYU_MODE=test
PAYU_TEST_MERCHANT_KEY=
PAYU_TEST_MERCHANT_SALT=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Optional overrides (defaults depend on mode)
PAYU_BASE_URL=
PAYU_VERIFY_PAYMENT_URL=
PAYU_SUCCESS_URL=
PAYU_FAILURE_URL=
PAYU_WEBHOOK_URL=
